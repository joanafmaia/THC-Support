# Discord Bot
DISCORD_TOKEN=your_discord_token_here

# MongoDB Atlas (free tier: https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/thc-support?retryWrites=true&w=majority
DB_TIMEOUT_MS=10000

# Server
PORT=3000

# Logging (error | warn | info | debug)
LOG_LEVEL=info

# Backups (stored in MongoDB, not on disk)
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Rate Limiting
RATE_LIMIT_COOLDOWN_MS=5000

# Scheduler
CHECK_INTERVAL_MS=60000
MAX_SEND_ATTEMPTS=5

# Stats (optional — protege o endpoint /stats no Render)
STATS_TOKEN=
